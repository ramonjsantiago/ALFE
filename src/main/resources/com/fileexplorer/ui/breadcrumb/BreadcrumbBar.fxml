<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<!--
  BreadcrumbBar.fxml
  - Explicitly declares the crumb container (fx:id="crumbContainer") as the ScrollPane content.
  - Matches BreadcrumbController injection fields:
      root, crumbScroll, crumbContainer, addressField, dropdownButton
  - Address field is hidden by default; the controller toggles visibility/managed for address mode.
-->
<HBox fx:id="root"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fileexplorer.controller.breadcrumb.BreadcrumbController"
      styleClass="breadcrumb-bar"
      spacing="8"
      alignment="CENTER_LEFT"
      minHeight="40.0"
      prefHeight="40.0"
      maxHeight="40.0">

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>

    <children>

        <!-- Normal breadcrumb (button crumbs inside scroll) -->
        <ScrollPane fx:id="crumbScroll"
                    styleClass="breadcrumb-scroll"
                    hbarPolicy="NEVER"
                    vbarPolicy="NEVER"
                    fitToHeight="true"
                    fitToWidth="true"
                    pannable="true"
                    minHeight="40.0"
                    prefHeight="40.0"
                    maxHeight="40.0"
                    HBox.hgrow="ALWAYS">
            <content>
                <HBox fx:id="crumbContainer"
                      styleClass="breadcrumb-crumb-container"
                      spacing="6"
                      alignment="CENTER_LEFT"
                      minHeight="40.0"
                      prefHeight="40.0"
                      maxHeight="40.0"/>
            </content>
        </ScrollPane>

        <!-- Address mode editor (controller sets visible/managed) -->
        <TextField fx:id="addressField"
                   promptText="Address"
                   visible="false"
                   managed="false"
                   styleClass="breadcrumb-address-field, address-field"
                   minHeight="30.0"
                   prefHeight="30.0"
                   maxHeight="30.0"
                   HBox.hgrow="ALWAYS"/>

        <!-- Overflow / actions dropdown (controller hides in address mode) -->
        <Button fx:id="dropdownButton"
                focusTraversable="false"
                minWidth="32.0"
                prefWidth="32.0"
                maxWidth="32.0"
                minHeight="30.0"
                prefHeight="30.0"
                maxHeight="30.0"
                styleClass="breadcrumb-dropdown-button">
            <graphic>
                <!-- Chevron down; keep as a label so CSS can apply icon font if desired -->
                <Label text="▾" styleClass="breadcrumb-dropdown-glyph"/>
            </graphic>
        </Button>

    </children>
</HBox>
