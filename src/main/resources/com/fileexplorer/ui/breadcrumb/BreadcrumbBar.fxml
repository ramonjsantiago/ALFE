<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<HBox fx:id="root"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fileexplorer.controller.breadcrumb.BreadcrumbController"
      styleClass="breadcrumb-bar, explorer-breadcrumb-shell"
      spacing="0"
      alignment="CENTER_LEFT"
      minHeight="32.0"
      prefHeight="32.0"
      maxHeight="32.0">

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>

    <children>
        <StackPane styleClass="address-shell, explorer-address-pill" HBox.hgrow="ALWAYS" minHeight="32.0" prefHeight="32.0" maxHeight="32.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="0" styleClass="address-content-host" minHeight="32.0" prefHeight="32.0" maxHeight="32.0">
                    <children>
                        <Label text="&#xE8B7;" styleClass="fluent-icon, address-leading-icon"/>
                        <ScrollPane fx:id="crumbScroll"
                                    styleClass="breadcrumb-scroll"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="NEVER"
                                    fitToHeight="true"
                                    fitToWidth="true"
                                    pannable="true"
                                    minHeight="32.0"
                                    prefHeight="32.0"
                                    maxHeight="32.0"
                                    HBox.hgrow="ALWAYS">
                            <content>
                                <HBox fx:id="crumbContainer"
                                      styleClass="breadcrumb-crumb-container, explorer-crumb-container"
                                      spacing="4"
                                      alignment="CENTER_LEFT"
                                      minHeight="32.0"
                                      prefHeight="32.0"
                                      maxHeight="32.0"/>
                            </content>
                        </ScrollPane>

                        <TextField fx:id="addressField"
                                   promptText="Address"
                                   visible="false"
                                   managed="false"
                                   styleClass="breadcrumb-address-field, address-field, explorer-address-field"
                                   minHeight="28.0"
                                   prefHeight="28.0"
                                   maxHeight="28.0"
                                   HBox.hgrow="ALWAYS"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="dropdownButton"
                                focusTraversable="false"
                                minWidth="28.0"
                                prefWidth="28.0"
                                maxWidth="28.0"
                                minHeight="28.0"
                                prefHeight="28.0"
                                maxHeight="28.0"
                                styleClass="breadcrumb-dropdown-button, explorer-address-dropdown">
                            <graphic>
                                <Label text="&#xE70D;" styleClass="fluent-icon, breadcrumb-dropdown-glyph"/>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </children>
</HBox>
