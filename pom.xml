<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fileexplorer</groupId>
    <artifactId>FileExplorer</artifactId>
    <version>0.1.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>25</javafx.version>
        <app.xms>512m</app.xms>
        <app.xmx>4g</app.xmx>
        <fileexplorer.log.enter>false</fileexplorer.log.enter>
        <fileexplorer.resourceAudit>false</fileexplorer.resourceAudit>
        <fileexplorer.debug.printJvmArgs>true</fileexplorer.debug.printJvmArgs>
        <fileexplorer.maxTreeChildDirs>2000</fileexplorer.maxTreeChildDirs>
        <fileexplorer.maxDirEntries>5000</fileexplorer.maxDirEntries>
        <fileexplorer.ui.loadBundledFonts>false</fileexplorer.ui.loadBundledFonts>
        <fileexplorer.ui.enforceMinMetrics>false</fileexplorer.ui.enforceMinMetrics>
        <fileexplorer.ui.tree.fixedCellSize>22</fileexplorer.ui.tree.fixedCellSize>
        <!-- Startup layout guards for virtualized controls (prevent runaway VirtualFlow) -->
        <fileexplorer.ui.tree.prefHeight>720</fileexplorer.ui.tree.prefHeight>
        <fileexplorer.ui.tree.prefWidth>280</fileexplorer.ui.tree.prefWidth>
        <fileexplorer.ui.tree.maxCells>5000</fileexplorer.ui.tree.maxCells>
        <fileexplorer.ui.table.prefHeight>720</fileexplorer.ui.table.prefHeight>
        <fileexplorer.ui.table.prefWidth>-1</fileexplorer.ui.table.prefWidth>

        <fileexplorer.ui.table.fixedCellSize>-1</fileexplorer.ui.table.fixedCellSize>
        <fileexplorer.safeMode>false</fileexplorer.safeMode>
        <fileexplorer.safeMode.maxDirEntries>500</fileexplorer.safeMode.maxDirEntries>
        <fileexplorer.safeMode.maxDirEntries.hardMax>2000</fileexplorer.safeMode.maxDirEntries.hardMax>
    </properties>

    <dependencies>
        <!-- JavaFX Core -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JUnit (optional) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>

        <!-- TwelveMonkeys ImageIO: core + common image types -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-core</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-bmp</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-tiff</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-psd</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-jpeg</artifactId>
            <version>3.12.0</version>
        </dependency>

        <!-- Image4J (ICO/CUR decoding support) - Maven Central -->
        <dependency>
            <groupId>org.jclarion</groupId>
            <artifactId>image4j</artifactId>
            <version>0.7</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JavaFX Maven Plugin for running -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.fileexplorer.app.MainApp</mainClass>
                    <options>
                        <option>-Xms${app.xms}</option>
                        <option>-Xmx${app.xmx}</option>
                        <option>-XX:+HeapDumpOnOutOfMemoryError</option>
                        <option>-XX:HeapDumpPath=./heapdumps</option>
                        <!-- Use a relative path to avoid JVM arg tokenization issues when the project path contains spaces. -->
                        <option>-Djava.util.logging.config.file=./config/logging.properties</option>
                        <option>-XX:+StartAttachListener</option>
                        <!-- FileExplorer runtime toggles (pass-through from mvn -D... into the launched JVM) -->
                        <option>-Dfileexplorer.log.enter=${fileexplorer.log.enter}</option>
                        <option>-Dfileexplorer.resourceAudit=${fileexplorer.resourceAudit}</option>
                        <option>-Dfileexplorer.debug.printJvmArgs=${fileexplorer.debug.printJvmArgs}</option>
                        <option>-Dfileexplorer.maxTreeChildDirs=${fileexplorer.maxTreeChildDirs}</option>
                        <option>-Dfileexplorer.maxDirEntries=${fileexplorer.maxDirEntries}</option>
                        <option>-Dfileexplorer.ui.loadBundledFonts=${fileexplorer.ui.loadBundledFonts}</option>
                        <option>-Dfileexplorer.ui.enforceMinMetrics=${fileexplorer.ui.enforceMinMetrics}</option>
                        <option>-Dfileexplorer.safeMode=${fileexplorer.safeMode}</option>
                        <option>-Dfileexplorer.safeMode.maxDirEntries=${fileexplorer.safeMode.maxDirEntries}</option>
                        <option>-Dfileexplorer.safeMode.maxDirEntries.hardMax=${fileexplorer.safeMode.maxDirEntries.hardMax}</option>
                    
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
